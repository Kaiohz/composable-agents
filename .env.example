OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
AGENTS_DIR=./agents
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# === OpenAI-compatible endpoint (OpenRouter, LiteLLM, vLLM, etc.) ===
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# === PostgreSQL ===
DATABASE_URL=postgresql://raganything:raganything@localhost:5433/raganything

# Explicitly disable database TLS certificate/hostname verification.
# Keep false in production. Use true only for local/self-signed development.
DATABASE_SSL_INSECURE=false

# Set to 0 when using a connection pooler (Neon, PgBouncer, etc.)
# Leave commented to use asyncpg's default
# POSTGRES_STATEMENT_CACHE_SIZE=0

# === MinIO ===
MINIO_ENDPOINT=localhost:9040
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=composable-agents
MINIO_SECURE=false

# === Tracing ===
PROVIDER=phoenix # or "langfuse" or "none"
PROJECT_NAME=composable-agents
PHOENIX_COLLECTOR_ENDPOINT=https://phoenix.soludev.tech/
PHOENIX_API_KEY=your-phoenix-api-key

# === mcp-raganything API Key ===
# Shared secret key for authenticating MCP requests to the raganything service.
# Must match the API_KEY set in mcp-raganything's .env.
MCP_RAGANYTHING_API_KEY=

# === Composable MCP control plane (feat-composable-mcp) ===
# Trusted mcp-raganything registry service base URL (MCP registry tools and the
# built-in assistant's server-side execution-config resolution both forward the
# ORIGINATING user credential to it; REQ-017/REQ-037). Never hard-coded in code.
MCP_REGISTRY_BASE_URL=
# Internal base URL of the built-in mcp-raganything MCP mounts whose paths are
# /files/mcp, /classical/mcp, /web/mcp and /memories/mcp (server-side resolution
# for the built-in assistant's toolset only; never derived from the frontend
# config.json).
BUILTIN_MCP_BASE_URL=

# === MCP OAuth2 dual auth (feat-mcp-oauth2-dual-auth) ===
# Legacy single JWT audience (Logto UI app-id). Extra audiences (comma-separated,
# e.g. the Logto OpenCode app-id) are merged with the legacy value
# (deduped, legacy first). Absent/empty → legacy-only.
# JWT_AUDIENCE=ui-app-id
# JWT_AUDIENCES=ui-app-id,opencode-app-id
# MCP transport-security Host allow-list (comma-separated). DNS-rebinding
# protection stays ENABLED: list the public proxy host (REQ-013 configmap)
# plus the localhost entries. A present-but-EMPTY value REFUSES STARTUP (an
# empty allow-list would 421 every MCP request).
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,composables-agent.soludev.tech
# Public origin advertised by the OAuth2 discovery documents (the 401
# WWW-Authenticate challenge and /.well-known/oauth-protected-resource).
# Always set it in production (the request Host header is client-supplied and
# never echoed unvalidated); when unset only request Hosts explicitly listed
# in MCP_ALLOWED_HOSTS may be used as the discovery origin (REQ-002/M-2).
MCP_PUBLIC_BASE_URL=https://composables-agent.soludev.tech
# Public OAuth2 authorization server advertised by the protected-resource
# metadata document (REQ-002, QA BUG-003): the Logto issuer an MCP client can
# actually REACH (Logto serves AS metadata under /oidc). When unset the doc
# falls back to <LOGTO_URL>/oidc — set it explicitly in production whenever
# LOGTO_URL is a container-internal address (it must stay one: the backend
# fetches its JWKS from it). Empty with no LOGTO_URL → nothing advertised.
MCP_AUTHORIZATION_SERVER=https://logto.soludev.tech/oidc


# === Chat attachments + create_pdf limits (chat-pdf-attachments spec) ===
# Read at Settings load. Absent/empty → spec default silently; present but
# invalid or incoherent (max_image > max_document > max_total) refuses startup.
# CHAT_ATTACHMENT_MAX_COUNT=10
# CHAT_ATTACHMENT_MAX_TOTAL_BYTES=52428800
# CHAT_ATTACHMENT_MAX_IMAGE_BYTES=10485760
# CHAT_ATTACHMENT_MAX_DOCUMENT_BYTES=52428800
# CREATE_PDF_MAX_MARKDOWN_CHARS=1000000
